# AI Provider Configuration
# Options: "openrouter" or "openai"
# Default: openrouter (recommended - access to multiple models including Deepseek)
AI_PROVIDER=openrouter

# OpenRouter Configuration (recommended)
# Get your API key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
# Optional: Help OpenRouter identify your app
OPENROUTER_SITE_URL=https://infinite-story.ai
OPENROUTER_SITE_NAME=Infinite Story Engine

# OpenRouter Model Selection
# Default: deepseek-v3 (best for story generation)
# Options:
#   deepseek-v3 (recommended - excellent for creative writing)
#   deepseek-chat
#   gpt-4-turbo (via OpenRouter)
#   gpt-4
#   gpt-3.5-turbo
#   claude-3-opus
#   claude-3-sonnet
#   claude-3-haiku
#   mixtral-8x22b
#   llama-2-70b
AI_MODEL=deepseek-v3

# OpenAI Configuration (alternative)
# Only needed if AI_PROVIDER=openai
# Get your API key at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com

# Shared AI Configuration
# Temperature: 0.0 (deterministic) to 2.0 (very creative)
# Recommended for storytelling: 0.7-0.9
AI_TEMPERATURE=0.7

# Maximum tokens per generation
# Recommended: 2000-3000 for story generation
AI_MAX_TOKENS=2000

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
